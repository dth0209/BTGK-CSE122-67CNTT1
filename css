* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
}

body {
  background-color: #ffffff;
  color: #333333;
}

/* 1. Header */
.phandau {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 20px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.logo {
  text-decoration: none;
  font-size: 20px;
  font-weight: bold;
  color: #00684a;
}

.nuttrangchu {
  text-decoration: none;
  font-size: 14px;
  color: #4b5563;
}

.khungchinh {
  display: flex;
  min-height: 100vh;
}

.cottrai {
  flex: 1;
  background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.75)), 
                    url('../assets/thiennhien.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: flex-end;
  padding: 50px;
}

.hopchu {
  color: #ffffff;
  max-width: 450px;
}

.tieudeanh {
  font-size: 32px;
  margin-bottom: 10px;
}

.motaanh {
  font-size: 16px;
  line-height: 1.5;
}

.cotphai {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 20px 40px;
}

.hopform {
  width: 100%;
  max-width: 520px; 

.tieudeform {
  font-size: 36px;
  margin-bottom: 10px;
  color: #111827;
}

.motaform {
  font-size: 16px;
  color: #6b7280;
  margin-bottom: 30px;
}

.hangnhap {
  margin-bottom: 22px;
  display: flex;
  flex-direction: column;
}

.nhan {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 8px;
  color: #1f2937;
}

.onhap {
  width: 100%;
  padding: 16px 20px;
  font-size: 17px;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  outline: none;
  background-color: #f9fafb;
}

.onhap:focus {
  background-color: #ffffff;
}

.baoloi {
  color: #dc2626;
  font-size: 13px;
  margin-top: 6px;
  min-height: 16px;
}

.vienloi {
  border-color: #dc2626 !important;
}

.vienxanh {
  border-color: #16a34a !important;
}

/* 7. Nút đăng ký */
.nutgui {
  width: 100%;
  padding: 16px;
  background-color: #00684a;
  color: #ffffff;
  border: none;
  border-radius: 10px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
}

.nutgui:hover {
  background-color: #005039;
}

.nutgui:hover {
  background-color: #005039;
}

.nuthotro {
  position: fixed;
  bottom: 25px;
  right: 25px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: none;
  background-color: #00684a;
  color: #ffffff;
  font-size: 20px;
  cursor: pointer;
}

@media (max-width: 768px) {
  .khungchinh {
    flex-direction: column;
  }
  .cottrai {
    display: none;
  }
  .phandau {
    position: static;
    padding: 15px 20px;
    border-bottom: 1px solid #e5e7eb;
  }
  .cotphai {
    padding: 40px 20px;
  }
}
